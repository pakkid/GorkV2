# Discord — https://discord.com/developers/applications
# enable the Message Content + Server Members privileged intents
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_OWNER_ID=

# AI — any OpenAI-compatible OpenRouter endpoint
# hack club proxy works too: AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-3-flash-preview
# comma separated, tried in order if the main model fails
AI_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-5-mini
# none | minimal | low | medium | high  (lower = faster)
AI_REASONING=minimal

# LOG_LEVEL=info
