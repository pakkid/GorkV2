# Discord — https://discord.com/developers/applications
# enable the Message Content privileged intent (Bot tab)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_OWNER_ID=

# AI — OpenRouter by default. Any other OpenAI-compatible gateway works too:
#   AI_BASE_URL=http://n1.eclipsesystems.org:30012/v1
#   AI_API_KEY=sk-...
#   AI_MODEL=deepseek/deepseek-v4.1-flash
# Hack Club proxy: AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_API_KEY=
# AI_BASE_URL=
AI_MODEL=deepseek/deepseek-v4.1-flash
# comma separated, tried in order if the main model fails
AI_FALLBACK_MODELS=minimax-m3.1-flash,z-ai/glm-5.3-flash
# openrouter | openai — auto-detected from AI_BASE_URL if unset
# AI_PROVIDER=
# none | minimal | low | medium | high  (lower = faster). OpenRouter defaults to minimal;
# other gateways only get it if you set it
# AI_REASONING=
# $ per million tokens (input/output) for the stats page's cost estimates, on top of the
# built-in table in src/config.ts. Only needed for other models or if prices change:
# AI_PRICES=some/model=0.10/0.40

# web search, like the original gork (https://dashboard.exa.ai/api-keys). leave empty to turn it off
# EXA_API_KEY=

# gork's clock and hometown (defaults: this machine's timezone, New York)
# TZ=Pacific/Auckland
# GORK_LOCATION=Auckland, New Zealand

# LOG_LEVEL=info

# stats + behaviour editor web ui (LAN only). 0 turns it off
# WEB_PORT=8787
# docker: host ip/port to publish it on. use your LAN ip to keep it off other interfaces
# WEB_BIND=192.168.1.20
# WEB_HOST_PORT=8787
